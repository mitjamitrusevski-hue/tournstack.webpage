# Store real values in the host's private environment settings, never in Git.
SMTP_USER=info@tournstack.com
SMTP_PASSWORD=
# A separate random secret, at least 32 characters; also set in Apps Script.
MAIL_RELAY_TOKEN=
HOST=127.0.0.1
PORT=3010
QUEUE_PATH=./data/mail.sqlite
# Local operational caps, not mailbox.org account quotas.
MAX_CONTACTS_PER_DAY=100
MAX_CONFIRMATIONS_PER_ADDRESS_PER_DAY=3
