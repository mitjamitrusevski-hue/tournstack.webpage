{
  "name": "TournStack website asset caching",
  "kind": "zone",
  "phase": "http_request_cache_settings",
  "rules": [
    {
      "ref": "tournstack_non_asset_bypass",
      "description": "Keep pages, utilities and mutable URLs outside long edge caching",
      "expression": "(http.host in {\"tournstack.com\" \"www.tournstack.com\"} and not starts_with(http.request.uri.path, \"/assets/versioned/\"))",
      "action": "set_cache_settings",
      "action_parameters": { "cache": false },
      "enabled": true
    },
    {
      "ref": "tournstack_versioned_assets",
      "description": "One-year browser cache for content-hashed website assets",
      "expression": "(http.host in {\"tournstack.com\" \"www.tournstack.com\"} and http.request.method in {\"GET\" \"HEAD\"} and starts_with(http.request.uri.path, \"/assets/versioned/\"))",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "browser_ttl": { "mode": "respect_origin" },
        "edge_ttl": {
          "mode": "override_origin",
          "default": 2592000,
          "status_code_ttl": [
            { "status_code_range": { "from": 300 }, "value": -1 }
          ]
        }
      },
      "enabled": true
    }
  ]
}
